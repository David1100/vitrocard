---
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  active: 'dashboard' | 'clientes' | 'salones' | 'visitas' | 'recompensas' | 'configuracion';
}

const { title, active } = Astro.props;

const links: { href: string; label: string; key: string }[] = [
  { href: '/admin', label: 'Panel', key: 'dashboard' },
  { href: '/admin/clientes', label: 'Clientes', key: 'clientes' },
  { href: '/admin/salones', label: 'Salones', key: 'salones' },
  { href: '/admin/visitas', label: 'Visitas', key: 'visitas' },
  { href: '/admin/recompensas', label: 'Recompensas', key: 'recompensas' },
  { href: '/admin/configuracion', label: 'Configuración', key: 'configuracion' },
];
---

<BaseLayout title={title} theme="light">
  <div class="flex min-h-screen">
    <!-- Sidebar editorial -->
    <aside class="hidden w-60 shrink-0 flex-col justify-between border-r border-cream-300/60 bg-cream-100/60 px-6 py-10 md:flex">
      <div>
        <a href="/consulta"><Logo class="mb-12" /></a>
        <nav class="space-y-1" aria-label="Navegación del panel">
          {links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'block rounded-xl px-4 py-3 font-display text-lg italic transition',
                active === l.key
                  ? 'bg-ink-900 text-cream-50 shadow-soft'
                  : 'text-ink-500 hover:bg-cream-200/70 hover:text-ink-900',
              ]}
              aria-current={active === l.key ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))}
        </nav>
      </div>
      <footer class="text-[10px] uppercase tracking-[0.3em] text-ink-400">
        <p>Vitro · Fase prestige</p>
      </footer>
    </aside>

    <!-- Nav móvil -->
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="flex items-center justify-between gap-3 border-b border-cream-300/60 px-5 py-4 md:hidden">
        <a href="/consulta"><Logo /></a>
        <nav class="flex gap-2 text-xs uppercase tracking-widest">
          {links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'rounded-lg px-3 py-2',
                active === l.key ? 'bg-ink-900 text-cream-50' : 'text-ink-500',
              ]}
            >
              {l.label}
            </a>
          ))}
        </nav>
      </header>

      <main class="min-w-0 flex-1 px-5 py-8 sm:px-8 lg:px-12">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
